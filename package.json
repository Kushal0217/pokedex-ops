{
  "name": "kushals-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "check:build": "node scripts/check-build.mjs",
    "test": "node --test scripts/test/*.test.mjs",
    "import:flights": "node scripts/import-flights.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "topojson-client": "3.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "world-atlas": "2.0.2"
  }
}
