# Read path: the agent's least-privilege, read-only role.
POKEDEX_AGENT_DSN=postgresql://pokedex_agent:agent@localhost:5433/pokedex
# Write path: used only by apply_index (CREATE INDEX needs the table owner).
POKEDEX_DBA_DSN=postgresql://pokedex_dba:dba@localhost:5433/pokedex
# Superuser: used only by the seed script and eval fixtures, never by the agent.
POKEDEX_ADMIN_DSN=postgresql://postgres:postgres@localhost:5433/pokedex
